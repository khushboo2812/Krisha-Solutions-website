# Krisha Solutions website – Apache settings (HostAfrica / DirectAdmin)

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Always use https://krishasolutions.net (no www). Let's Encrypt
# certificate renewals under /.well-known/ are left alone.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.krishasolutions\.net$ [NC]
  RewriteRule ^ https://krishasolutions.net%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^krishasolutions\.net$ [NC]
  RewriteRule ^ https://krishasolutions.net%{REQUEST_URI} [L,R=301]
</IfModule>

# Keep the deployment record private.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

# CSS and JS links include a version number that changes on every edit,
# so browsers can cache them for a long time.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>
